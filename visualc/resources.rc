#include <windows.h>

1 ICON "tyrian2000.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "opentyrian.manifest"

// Shown in the exe's Properties > Details.  The Makefile passes the version
// from git describe (e.g. v1.0.3 -> 1,0,3,0); other builds show 0.0.0.0.
#ifndef TYRIAN_VERSION_NUM
#define TYRIAN_VERSION_NUM 0,0,0,0
#endif
#ifndef TYRIAN_VERSION_STR
#define TYRIAN_VERSION_STR "unknown"
#endif

1 VERSIONINFO
FILEVERSION TYRIAN_VERSION_NUM
PRODUCTVERSION TYRIAN_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Tyrian 2000+ contributors"
			VALUE "FileDescription", "Tyrian 2000+"
			VALUE "FileVersion", TYRIAN_VERSION_STR
			VALUE "InternalName", "Tyrian2000Plus"
			VALUE "LegalCopyright", "GNU GPL v2 or later. Tyrian (C) Eclipse Software, freeware."
			VALUE "OriginalFilename", "Tyrian2000Plus.exe"
			VALUE "ProductName", "Tyrian 2000+"
			VALUE "ProductVersion", TYRIAN_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
