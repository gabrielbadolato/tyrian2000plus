; installer.nsi — Windows installer for Tyrian 2000+ (NSIS 3).
;
; Copyright (C) 2026 Tyrian 2000+ contributors
;
; This program is free software; you can redistribute it and/or modify it
; under the terms of the GNU General Public License as published by the Free
; Software Foundation; either version 2 of the License, or (at your option)
; any later version.
;
; Built by make_installer.sh, which passes PKG_FILES (the generated install
; and uninstall lists), OUTFILE, VERSION and VERSION_NUM.  The installer works
; per user (no administrator prompt): it installs into
; %LOCALAPPDATA%\Programs\Tyrian2000Plus, adds a Start menu shortcut (and,
; if left checked, one on the desktop) and an entry in Settings > Apps.
; Saves and settings live in %APPDATA%\Tyrian2000Plus, which the uninstaller
; never touches, and it removes only the files this installer put there.

Unicode true
ManifestDPIAware true
SetCompressor /SOLID lzma

!include "MUI2.nsh"
!include "FileFunc.nsh"
!include "${PKG_FILES}"

!define APP_NAME "Tyrian 2000+"
!define APP_EXE "Tyrian2000Plus.exe"
!define UNINSTALLER "Desinstalar.exe"
!define REG_APP "Software\Tyrian2000Plus"
!define REG_UNINSTALL "Software\Microsoft\Windows\CurrentVersion\Uninstall\Tyrian2000Plus"

Name "${APP_NAME}"
OutFile "${OUTFILE}"
InstallDir "$LOCALAPPDATA\Programs\Tyrian2000Plus"
InstallDirRegKey HKCU "${REG_APP}" "InstallDir"
RequestExecutionLevel user
BrandingText "${APP_NAME} ${VERSION}"

VIProductVersion "${VERSION_NUM}"
VIAddVersionKey /LANG=0 "ProductName" "${APP_NAME}"
VIAddVersionKey /LANG=0 "FileDescription" "${APP_NAME} installer"
VIAddVersionKey /LANG=0 "CompanyName" "Tyrian 2000+ contributors"
VIAddVersionKey /LANG=0 "LegalCopyright" "GNU GPL v2 or later. Tyrian (C) Eclipse Software, freeware."
VIAddVersionKey /LANG=0 "FileVersion" "${VERSION}"
VIAddVersionKey /LANG=0 "ProductVersion" "${VERSION}"

!define MUI_ICON "../visualc/tyrian2000.ico"
!define MUI_UNICON "../visualc/tyrian2000.ico"
!define MUI_ABORTWARNING
!define MUI_WELCOMEPAGE_TEXT "$(WelcomeText)"
!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_TEXT "$(RunGame)"
!define MUI_FINISHPAGE_RUN_FUNCTION RunGame
; The finish page's second checkbox, used for the desktop shortcut.
!define MUI_FINISHPAGE_SHOWREADME
!define MUI_FINISHPAGE_SHOWREADME_TEXT "$(DesktopShortcut)"
!define MUI_FINISHPAGE_SHOWREADME_FUNCTION CreateDesktopShortcut

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

; The first language is the fallback when Windows uses neither of them.
!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "PortugueseBR"

LangString WelcomeText ${LANG_ENGLISH} "This will install ${APP_NAME} ${VERSION}: Tyrian 2000 with modern controls.$\r$\n$\r$\nIt is an unofficial, free fan project. The original Tyrian 2000 game data (freeware, by Eclipse Software) comes with it, unchanged.$\r$\n$\r$\nYour saves and settings are kept when you update or uninstall."
LangString WelcomeText ${LANG_PORTUGUESEBR} "Este assistente instala o ${APP_NAME} ${VERSION}: o Tyrian 2000 com controles modernos.$\r$\n$\r$\nÉ um projeto de fã, gratuito e não oficial. Os dados originais do Tyrian 2000 (freeware, da Eclipse Software) vêm junto, sem alteração.$\r$\n$\r$\nSeus saves e configurações continuam ao atualizar ou desinstalar."
LangString RunGame ${LANG_ENGLISH} "Play ${APP_NAME} now"
LangString RunGame ${LANG_PORTUGUESEBR} "Jogar o ${APP_NAME} agora"
LangString DesktopShortcut ${LANG_ENGLISH} "Create a desktop shortcut"
LangString DesktopShortcut ${LANG_PORTUGUESEBR} "Criar um atalho na área de trabalho"

Section
	; Generated by make_installer.sh: SetOutPath + File for every file.
	!insertmacro PKG_INSTALL

	SetOutPath "$INSTDIR"
	WriteUninstaller "$INSTDIR\${UNINSTALLER}"
	CreateShortCut "$SMPROGRAMS\${APP_NAME}.lnk" "$INSTDIR\${APP_EXE}"

	WriteRegStr HKCU "${REG_APP}" "InstallDir" "$INSTDIR"
	WriteRegStr HKCU "${REG_UNINSTALL}" "DisplayName" "${APP_NAME}"
	WriteRegStr HKCU "${REG_UNINSTALL}" "DisplayVersion" "${VERSION}"
	WriteRegStr HKCU "${REG_UNINSTALL}" "Publisher" "Tyrian 2000+ contributors"
	WriteRegStr HKCU "${REG_UNINSTALL}" "URLInfoAbout" "https://github.com/gabrielbadolato/tyrian2000plus"
	WriteRegStr HKCU "${REG_UNINSTALL}" "DisplayIcon" "$INSTDIR\${APP_EXE}"
	WriteRegStr HKCU "${REG_UNINSTALL}" "InstallLocation" "$INSTDIR"
	WriteRegStr HKCU "${REG_UNINSTALL}" "UninstallString" '"$INSTDIR\${UNINSTALLER}"'
	WriteRegStr HKCU "${REG_UNINSTALL}" "QuietUninstallString" '"$INSTDIR\${UNINSTALLER}" /S'
	WriteRegDWORD HKCU "${REG_UNINSTALL}" "NoModify" 1
	WriteRegDWORD HKCU "${REG_UNINSTALL}" "NoRepair" 1
	${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
	WriteRegDWORD HKCU "${REG_UNINSTALL}" "EstimatedSize" $0
SectionEnd

Function RunGame
	SetOutPath "$INSTDIR"
	Exec '"$INSTDIR\${APP_EXE}"'
FunctionEnd

Function CreateDesktopShortcut
	SetOutPath "$INSTDIR"
	CreateShortCut "$DESKTOP\${APP_NAME}.lnk" "$INSTDIR\${APP_EXE}"
FunctionEnd

Section "Uninstall"
	; Generated by make_installer.sh: Delete for every installed file, then
	; RMDir (only when empty) for each folder.  Nothing else in the folder,
	; such as files the player added, is removed.
	!insertmacro PKG_UNINSTALL
	Delete "$INSTDIR\${UNINSTALLER}"
	RMDir "$INSTDIR"

	Delete "$SMPROGRAMS\${APP_NAME}.lnk"
	Delete "$DESKTOP\${APP_NAME}.lnk"
	DeleteRegKey HKCU "${REG_UNINSTALL}"
	DeleteRegKey HKCU "${REG_APP}"
SectionEnd
